<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hotels_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@android:color/white"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Отели"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue" />

                    <LinearLayout
                        android:id="@+id/filterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/chip_unselected"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_filter"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Фильтры"
                            android:textColor="@color/dark_gray"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:background="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍 Город"
                                android:textSize="12sp"
                                android:textColor="@color/medium_gray" />

                            <AutoCompleteTextView
                                android:id="@+id/cityAutoComplete"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="Выберите город"
                                android:textSize="16sp"
                                android:background="@null"
                                android:drawableRight="@android:drawable/arrow_down_float" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/medium_gray" />

                        </LinearLayout>

                        <!-- Популярные города -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Популярные города"
                            android:textSize="12sp"
                            android:textColor="@color/medium_gray"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/cityAlmaty"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Алматы"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityAstana"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Астана"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityShymkent"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Шымкент"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <!-- Вторая строка городов -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/cityAktau"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Актау"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityAktobe"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Актобе"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityKaraganda"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Караганда"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <!-- Третья строка городов -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/cityTaraz"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Тараз"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityPavlodar"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Павлодар"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityTurkistan"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Туркестан"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <!-- Даты -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📅 Заезд"
                                    android:textSize="12sp"
                                    android:textColor="@color/medium_gray" />

                                <EditText
                                    android:id="@+id/checkInDate"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:text="Выберите дату"
                                    android:gravity="center_vertical"
                                    android:textSize="14sp"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:background="@null" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/medium_gray" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="📅 Выезд"
                                    android:textSize="12sp"
                                    android:textColor="@color/medium_gray" />

                                <EditText
                                    android:id="@+id/checkOutDate"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:text="Выберите дату"
                                    android:gravity="center_vertical"
                                    android:textSize="14sp"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:cursorVisible="false"
                                    android:background="@null" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/medium_gray" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Гости -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👥 Гости"
                                android:textSize="12sp"
                                android:textColor="@color/medium_gray" />

                            <LinearLayout
                                android:id="@+id/guestsLayout"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/guestsText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="1 взрослый"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@android:drawable/ic_menu_edit" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/medium_gray" />

                        </LinearLayout>

                        <!-- Кнопка поиска (синяя) -->
                        <Button
                            android:id="@+id/searchButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="Найти отели"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_button_blue"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Активные фильтры -->
                <LinearLayout
                    android:id="@+id/activeFiltersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Список отелей -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет отелей"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                android:textSize="16sp"
                android:textColor="@color/medium_gray" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>