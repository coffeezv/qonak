<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    app:behavior_hideable="false"
    app:behavior_peekHeight="80dp">

    <!-- Заголовок с drag handle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@color/medium_gray"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Фильтры"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue" />

            <TextView
                android:id="@+id/resetAllText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сбросить всё"
                android:textColor="@color/primary_blue"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Город -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Город"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <AutoCompleteTextView
                android:id="@+id/filterCity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Все города"
                android:padding="12dp"
                android:background="@drawable/bg_edittext"
                android:layout_marginTop="4dp" />

            <!-- Сортировка -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сортировка"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/sortSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_edittext" />

            <!-- Цена -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Цена за ночь (₸)"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/minPrice"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="от"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/maxPrice"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="до"
                    android:inputType="number"
                    android:padding="12dp"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Рейтинг с кнопками-чипсами -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Рейтинг"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/ratingAny"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Любой"
                    android:gravity="center"
                    android:background="@drawable/chip_selected"
                    android:textColor="@android:color/white"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/rating3"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="★ 3+"
                    android:gravity="center"
                    android:background="@drawable/chip_unselected"
                    android:textColor="@color/dark_gray"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/rating4"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="★ 4+"
                    android:gravity="center"
                    android:background="@drawable/chip_unselected"
                    android:textColor="@color/dark_gray"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/rating45"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="★ 4.5+"
                    android:gravity="center"
                    android:background="@drawable/chip_unselected"
                    android:textColor="@color/dark_gray" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Кнопка Применить -->
    <Button
        android:id="@+id/applyFilterButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="Показать"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:textColor="@android:color/white" />

</LinearLayout>