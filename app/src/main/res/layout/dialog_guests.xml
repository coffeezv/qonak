<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выберите количество гостей"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Взрослые -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Взрослые"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseAdults"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:background="@drawable/chip_unselected" />

            <TextView
                android:id="@+id/adultsCount"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="1"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/increaseAdults"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:background="@drawable/chip_unselected" />

        </LinearLayout>

    </LinearLayout>

    <!-- Дети -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Дети"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/decreaseChildren"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:background="@drawable/chip_unselected" />

            <TextView
                android:id="@+id/childrenCount"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="0"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/increaseChildren"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:background="@drawable/chip_unselected" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/confirmGuests"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Подтвердить"
        android:background="@drawable/bg_button_primary"
        android:textColor="@android:color/white"
        android:layout_marginTop="8dp" />

</LinearLayout>