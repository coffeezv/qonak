<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/restaurants_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@android:color/white"
            app:titleEnabled="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp"
                app:layout_collapseMode="pin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Рестораны"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_orange" />

                    <LinearLayout
                        android:id="@+id/filterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/chip_unselected"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_filter"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Фильтры"
                            android:textColor="@color/dark_gray"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:background="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍 Город"
                                android:textSize="12sp"
                                android:textColor="@color/medium_gray" />

                            <AutoCompleteTextView
                                android:id="@+id/cityAutoComplete"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="Выберите город"
                                android:textSize="16sp"
                                android:background="@null"
                                android:drawableRight="@android:drawable/arrow_down_float" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/medium_gray" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Популярные города"
                            android:textSize="12sp"
                            android:textColor="@color/medium_gray"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/cityAlmaty"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Алматы"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityAstana"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Астана"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityShymkent"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Шымкент"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/cityAktau"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Актау"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityAktobe"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Актобе"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityKaraganda"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Караганда"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:id="@+id/cityTaraz"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Тараз"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityPavlodar"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Павлодар"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:layout_marginEnd="4dp"
                                android:clickable="true"
                                android:focusable="true" />

                            <TextView
                                android:id="@+id/cityTurkistan"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Туркестан"
                                android:gravity="center"
                                android:background="@drawable/chip_unselected"
                                android:textColor="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true" />

                        </LinearLayout>

                        <!-- Тип кухни -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🍳 Тип кухни"
                                android:textSize="12sp"
                                android:textColor="@color/medium_gray" />

                            <!-- Первая строка кухонь -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:id="@+id/cuisineAny"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Любая"
                                    android:gravity="center"
                                    android:background="@drawable/chip_selected_restaurant"
                                    android:textColor="@android:color/white"
                                    android:layout_marginEnd="4dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineKazakh"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Казахская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:layout_marginEnd="4dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineEuropean"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Европейская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:clickable="true"
                                    android:focusable="true" />

                            </LinearLayout>

                            <!-- Вторая строка кухонь -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:id="@+id/cuisineItalian"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Итальянская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:layout_marginEnd="4dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineFrench"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Французская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:layout_marginEnd="4dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineJapanese"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Японская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:clickable="true"
                                    android:focusable="true" />

                            </LinearLayout>

                            <!-- Третья строка кухонь -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:id="@+id/cuisinePanAsian"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Паназиатская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:layout_marginEnd="4dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineChinese"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Китайская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:layout_marginEnd="4dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineKorean"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Корейская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:clickable="true"
                                    android:focusable="true" />

                            </LinearLayout>

                            <!-- Четвертая строка кухонь -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:id="@+id/cuisineUzbek"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Узбекская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:layout_marginEnd="4dp"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineGeorgian"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Грузинская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:clickable="true"
                                    android:focusable="true" />

                                <TextView
                                    android:id="@+id/cuisineAmerican"
                                    android:layout_width="0dp"
                                    android:layout_height="36dp"
                                    android:layout_weight="1"
                                    android:text="Американская"
                                    android:gravity="center"
                                    android:background="@drawable/chip_unselected"
                                    android:textColor="@color/dark_gray"
                                    android:clickable="true"
                                    android:focusable="true" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/medium_gray"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👥 Гости"
                                android:textSize="12sp"
                                android:textColor="@color/medium_gray" />

                            <LinearLayout
                                android:id="@+id/guestsLayout"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/guestsText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="1 взрослый"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@android:drawable/ic_menu_edit" />

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/medium_gray" />

                        </LinearLayout>

                        <Button
                            android:id="@+id/searchButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="8dp"
                            android:text="Найти рестораны"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_button_orange"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/activeFiltersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Нет ресторанов"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:visibility="gone"
                android:textSize="16sp"
                android:textColor="@color/medium_gray" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/restaurantsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>